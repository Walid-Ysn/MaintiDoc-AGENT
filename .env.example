# Clé API Groq (obligatoire pour produire des réponses)
GROQ_API_KEY=replace-me

# Optionnel : ajuster le modèle compatible OpenAI ou l’URL API
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Facultatif : chemin SQLite (par défaut instance/maintidoc.sqlite3)
# MAINTIDOC_DATABASE=instance/maintidoc.sqlite3
FLASK_DEBUG=0
